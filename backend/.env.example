PORT=8080
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ohara
DB_USER=postgres
DB_PASSWORD=changeme
# Only needed to run the test suite; truncated between tests, never point it
# at a database you care about.
DB_NAME_TEST=ohara_test

# JWT (minimum 32 characters!)
ACCESS_TOKEN_SECRET=replace-with-a-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-random-32-plus-character-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Ohara <no-reply@yourdomain.com>"

# LLM (Groq) — https://console.groq.com/keys (MODEL default shown; safe to omit)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Document uploads (Phase 3) — defaults shown; safe to omit
MAX_UPLOAD_PDF_BYTES=20971520
MAX_LLM_SOURCE_CHARS=50000

# Cloudinary, https://cloudinary.com/console — course document + assignment
# submission uploads
MAX_UPLOAD_SUBMISSION_BYTES=20971520
CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# OAuth (GitHub)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# Rate limiting (defaults shown; safe to omit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

GRADING_RATE_LIMIT_WINDOW_MS=900000
GRADING_RATE_LIMIT_MAX=30

# Seed data for `npm run db:seed` (defaults shown; safe to omit)
SEED_ADMIN_EMAIL=admin@ohara.local
SEED_ADMIN_PASSWORD=changeme123

# CORS allowlist origin, and where OAuth/email links redirect back to
FRONTEND_URL=http://localhost:3000
